{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suunto-coach-parser.example/schemas/settings-v1.json",
  "title": "Suunto Coach settings",
  "type": "object",
  "required": ["schema_version", "settings"],
  "properties": {
    "schema_version": { "const": 1 },
    "settings": {
      "type": "object",
      "required": ["heart_rate"],
      "properties": {
        "heart_rate": {
          "type": "object",
          "required": ["fcMax", "zones"],
          "properties": {
            "fcMax": { "type": "integer", "minimum": 1, "maximum": 999 },
            "zones": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 1, "maximum": 999 } }
          }
        }
      }
    }
  }
}
